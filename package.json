{
  "name": "anybot-desktop",
  "version": "0.3.22",
  "private": true,
  "description": "A local workspace for your team of AI employees",
  "author": "Any Bot contributors",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "vite",
    "prestart": "npm run build",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:live:codex": "node tests/live-codex-smoke.mjs",
    "test:live:hermes": "node tests/live-hermes-smoke.mjs",
    "test:live:cursor": "node tests/live-cursor-smoke.mjs",
    "test:runtime": "electron tests/electron-runtime.cjs",
    "test:e2e": "electron tests/electron-threads.cjs",
    "verify:local": "node scripts/verify-local.mjs",
    "mobile:web": "vite build --config mobile/vite.config.mjs",
    "mobile:sync": "npm run mobile:web && npx cap sync",
    "mobile:build": "node scripts/mobile-build.mjs",
    "mobile:dev": "npm run mobile:sync && npx cap open android",
    "package": "npm run build && node scripts/package-electron.mjs --win nsis --config.electronDist=./node_modules/electron/dist --config.win.signExecutable=false",
    "package:portable": "npm run build && node scripts/package-electron.mjs --win portable --config.electronDist=./node_modules/electron/dist --config.win.signExecutable=false",
    "release:manifest": "node scripts/release-manifest.mjs",
    "doctor": "node scripts/doctor.mjs",
    "package:dir": "npm run build && node scripts/package-electron.mjs --dir --config.electronDist=./node_modules/electron/dist --config.win.signExecutable=false",
    "brand:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-brand.ps1",
    "brand:verify": "node scripts/verify-brand-package.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.8",
    "qrcode": "^1.5.4",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "dev.anybot.desktop",
    "productName": "Any Bot",
    "asar": true,
    "asarUnpack": [
      "runtime/approval-mcp.mjs"
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "runtime/**/*",
      "server/**/*",
      "games/**/*",
      "package.json",
      "!**/node_modules/@capacitor/**",
      "assets/brand/scout-16.png",
      "assets/brand/scout-32.png",
      "assets/brand/scout-256.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "anyBot",
      "icon": "assets/brand/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "artifactName": "anyBot-Setup-${version}.${ext}",
      "shortcutName": "Any Bot",
      "uninstallDisplayName": "Any Bot",
      "installerIcon": "assets/brand/app.ico",
      "uninstallerIcon": "assets/brand/app.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "gilfila",
      "repo": "anyBot-updates"
    },
    "portable": {
      "artifactName": "anyBot ${version}.${ext}"
    }
  }
}
